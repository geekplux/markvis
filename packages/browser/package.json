{
  "name": "@markvis/browser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser drop-in: draws chart code blocks and chart comments in the page",
  "exports": {
    ".": "./src/index.ts",
    "./enhance": "./src/enhance.ts",
    "./preview": "./src/preview.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build && vite build --mode iife"
  },
  "dependencies": {
    "@markvis/html": "workspace:*",
    "@markvis/parser": "workspace:*",
    "@markvis/render-svg": "workspace:*"
  },
  "devDependencies": {
    "vite": "^6.3.5"
  }
}
