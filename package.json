{
  "name": "markvis",
  "version": "2.2.0",
  "private": false,
  "type": "module",
  "description": "Charts as text in Markdown. Write a short chart block; markvis draws it as SVG from a script tag, JavaScript, React, or any Markdown renderer. Where it cannot draw, the numbers stay as a table.",
  "keywords": [
    "markdown",
    "chart",
    "charts",
    "svg",
    "visualization",
    "data-visualization",
    "markdown-it",
    "remark",
    "rehype",
    "mdx",
    "react",
    "react-markdown",
    "streaming",
    "llm",
    "github-action",
    "cli",
    "bar-chart"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geekplux/markvis.git"
  },
  "homepage": "https://markvis.js.org",
  "bugs": {
    "url": "https://github.com/geekplux/markvis/issues"
  },
  "author": "GeekPlux <geekplux@gmail.com> (http://geekplux.com/)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./parser": {
      "types": "./dist/parser.d.ts",
      "import": "./dist/parser.js"
    },
    "./render-svg": {
      "types": "./dist/render-svg.d.ts",
      "import": "./dist/render-svg.js"
    },
    "./ir": {
      "types": "./dist/ir.d.ts",
      "import": "./dist/ir.js"
    },
    "./remark": {
      "types": "./dist/remark.d.ts",
      "import": "./dist/remark.js"
    },
    "./rehype": {
      "types": "./dist/rehype.d.ts",
      "import": "./dist/rehype.js"
    },
    "./markdown-it": {
      "types": "./dist/markdown-it.d.ts",
      "import": "./dist/markdown-it.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./themes": {
      "types": "./dist/themes.d.ts",
      "import": "./dist/themes.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./min": "./dist/markvis.min.js"
  },
  "bin": {
    "markvis": "dist/cli.bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-dts.mjs && pnpm --filter @markvis/browser build && node scripts/copy-browser-dist.mjs",
    "prepack": "pnpm build && node scripts/assert-pack.mjs",
    "prepublishOnly": "node scripts/prepublish-guard.mjs",
    "pack:lib": "node scripts/pack-lib.mjs",
    "markvis": "node ./dist/cli.bin.js",
    "test": "vitest run",
    "schema:generate": "tsx packages/ir/scripts/generate-schema.ts",
    "schema:check": "vitest run packages/ir/src/json-schema.test.ts",
    "eval-prompts": "tsx scripts/eval-prompts.ts"
  },
  "peerDependencies": {
    "markdown-it": "^14.0.0",
    "react": ">=18",
    "remark": "^15.0.0"
  },
  "peerDependenciesMeta": {
    "markdown-it": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "remark": {
      "optional": true
    }
  },
  "devDependencies": {
    "@markvis/browser": "workspace:*",
    "@markvis/cli": "workspace:*",
    "@markvis/html": "workspace:*",
    "@markvis/ir": "workspace:*",
    "@markvis/markdown-it": "workspace:*",
    "@markvis/parser": "workspace:*",
    "@markvis/react": "workspace:*",
    "@markvis/remark": "workspace:*",
    "@markvis/render-svg": "workspace:*",
    "@markvis/themes": "workspace:*",
    "@markvis/types": "workspace:*",
    "@types/node": "^26.4.1",
    "happy-dom": "18",
    "markdown-it": "^14.1.0",
    "react": "^19.3.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "remark-rehype": "^11.1.2",
    "tsup": "^8.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
