{
  "name": "markvis",
  "version": "2.0.0-dev",
  "private": true,
  "type": "module",
  "description": "Markdown chart language: fence / GFM table / HTML comment -> Chart IR -> deterministic SVG",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "http://github.com/geekplux/markvis.git"
  },
  "author": "GeekPlux <geekplux@gmail.com> (http://geekplux.com/)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./ir": "./packages/ir/src/index.ts",
    "./parser": "./packages/parser/src/index.ts",
    "./render-svg": "./packages/render-svg/src/index.ts",
    "./cli": "./packages/cli/src/index.ts",
    "./remark": "./packages/remark/src/index.ts",
    "./markdown-it": "./packages/markdown-it/src/index.ts",
    "./browser": "./packages/browser/src/index.ts",
    "./themes": "./packages/themes/registry.ts"
  },
  "bin": {
    "markvis": "./packages/cli/bin.js"
  },
  "scripts": {
    "test": "vitest run",
    "markvis": "node ./packages/cli/bin.js",
    "schema:generate": "tsx packages/ir/scripts/generate-schema.ts",
    "schema:check": "vitest run packages/ir/src/json-schema.test.ts",
    "eval-prompts": "tsx scripts/eval-prompts.ts"
  },
  "dependencies": {
    "@markvis/browser": "workspace:*",
    "@markvis/cli": "workspace:*",
    "@markvis/ir": "workspace:*",
    "@markvis/markdown-it": "workspace:*",
    "@markvis/parser": "workspace:*",
    "@markvis/remark": "workspace:*",
    "@markvis/render-svg": "workspace:*",
    "@markvis/themes": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "markdown-it": "^14.1.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
