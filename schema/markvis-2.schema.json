{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/geekplux/markvis/schema/markvis-2.schema.json",
  "title": "markvis Chart IR",
  "description": "Generated from @markvis/ir ChartIRSchema. Do not hand-edit; run pnpm schema:generate.",
  "type": "object",
  "properties": {
    "markvis": {
      "type": "number",
      "const": 2
    },
    "type": {
      "type": "string",
      "enum": [
        "bar",
        "line",
        "area",
        "scatter",
        "pie",
        "hist",
        "heatmap",
        "funnel",
        "waterfall",
        "radar",
        "gauge",
        "sankey",
        "treemap"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "theme": {
      "type": "string",
      "enum": [
        "folio",
        "highcharts",
        "shadcn",
        "docs",
        "ant",
        "recharts"
      ],
      "default": "folio"
    },
    "palette": {
      "type": "string",
      "enum": [
        "ink",
        "porcelain",
        "warm",
        "cool",
        "vivid"
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "x": {
      "type": "string",
      "minLength": 1
    },
    "y": {
      "type": "string",
      "minLength": 1
    },
    "series": {
      "type": "string",
      "minLength": 1
    },
    "layout": {
      "type": "string",
      "enum": [
        "grouped",
        "stacked",
        "percent"
      ]
    },
    "innerRadius": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "min": {
      "type": "number"
    },
    "max": {
      "type": "number"
    },
    "surface": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "export"
      ],
      "default": "light"
    },
    "orient": {
      "type": "string",
      "enum": [
        "horizontal",
        "vertical"
      ]
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "table": {
      "type": "object",
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "minItems": 1
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "markvis",
    "type",
    "title",
    "x",
    "table"
  ],
  "additionalProperties": false
}
